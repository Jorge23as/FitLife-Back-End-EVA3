# Copiar a .env y completar. El .env no se sube a GitHub.
SECRET_KEY=cambiar-por-una-clave-secreta
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DB_NAME=fitlife
DB_USER=fitlife_app
DB_PASSWORD=cambiar
DB_HOST=127.0.0.1
DB_PORT=5432
# Segundos que vale cada QR de acceso (la app del socio lo renueva cada 30)
QR_VIGENCIA_SEGUNDOS=60

# En la instancia EC2 (producción) queda así (lo arma deploy/instalar.sh):
# SECRET_KEY=<generada con: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
# DEBUG=False
# ALLOWED_HOSTS=<subdominio>.duckdns.org,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://<subdominio>.duckdns.org
# HTTPS=True   (False mientras no exista el certificado de certbot)
